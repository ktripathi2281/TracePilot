# TracePilot reads these from the process environment (it does not load .env files itself).

# LLM credentials: read by the Anthropic SDK, never by TracePilot's own code.
ANTHROPIC_API_KEY=

# Model for the investigator and the skeptic.
TRACEPILOT_MODEL=claude-sonnet-5-5
# Model for the verifier's logic pass. Defaults to TRACEPILOT_MODEL when unset.
TRACEPILOT_VERIFIER_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max
TRACEPILOT_EFFORT=medium

# live   = call the API (default)
# record = call the API and save every request/response pair to a cassette (resumable)
# replay = answer only from the cassette; fails on any request that was not recorded
# Tests and CI use replay.
TRACEPILOT_LLM=replay
# Where cassettes live, one file per incident. Default: <out>/cassettes
TRACEPILOT_CASSETTE_DIR=eval/cassettes

# Hard cap on all tokens the models read or write in one investigation (cached tokens included).
MAX_TOKENS_PER_INVESTIGATION=1500000

# default = let the API fall back to another model if the requested one declines to answer
# off     = never fall back
TRACEPILOT_LLM_FALLBACKS=default
