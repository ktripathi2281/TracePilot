{
  "name": "tracepilot",
  "private": true,
  "version": "0.0.0",
  "description": "AI-native incident investigation + deterministic counterfactual replay for distributed backends.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "node scripts/ci.mjs",
    "tracepilot": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/cli/src/bin.ts",
    "calibrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/sim/scripts/calibrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
